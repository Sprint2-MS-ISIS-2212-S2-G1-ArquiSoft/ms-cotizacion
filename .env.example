# Aplicacion
NODE_ENV=development
PORT=3000
COTIZACION_NAME=cotizacion

# BD Cotizacion (PostgreSQL). DB_PORT=5435 es el puerto publicado por
# docker-compose.local.yml hacia el host; dentro de la red de compose es 5432.
DB_HOST=localhost
DB_PORT=5435
DB_USER=cotizacion
DB_PASSWORD=cotizacion
DB_NAME=cotizacion

# Muestra las consultas SQL en consola.
DB_LOGGING=false

# Microservicio terceros (Open Data). Unica dependencia saliente: regla 4 de
# CLAUDE.md, nunca una IP ni un host escrito en el codigo.
TERCEROS_URL=http://localhost:3007

# true en local (crea las tablas). En AWS: false, el esquema lo crea database/init.sql.
DB_SYNCHRONIZE=true
# true en AWS: RDS PostgreSQL 16 exige SSL.
DB_SSL=false
# Conexiones maximas del pool POR REPLICA (replicas max x pool <= max_connections de RDS).
DB_POOL_MAX=10
