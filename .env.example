# Aplicacion
NODE_ENV=development
PORT=3000
COTIZACION_NAME=cotizacion

# BD Cotizacion (PostgreSQL). DB_PORT=5435 es el puerto publicado por
# docker-compose.local.yml hacia el host; dentro de la red de compose es 5432.
DB_HOST=localhost
DB_PORT=5435
DB_USER=cotizacion
DB_PASSWORD=cotizacion
DB_NAME=cotizacion

# Muestra las consultas SQL en consola.
DB_LOGGING=false

# Microservicio terceros (Open Data). Unica dependencia saliente: regla 4 de
# CLAUDE.md, nunca una IP ni un host escrito en el codigo.
TERCEROS_URL=http://localhost:3007

# true en local (crea las tablas). En AWS: false, el esquema lo crea database/init.sql.
DB_SYNCHRONIZE=true
# true en AWS: RDS PostgreSQL 16 exige SSL.
DB_SSL=false
# Conexiones maximas del pool POR REPLICA (replicas max x pool <= max_connections de RDS).
DB_POOL_MAX=10

# ASR de disponibilidad (EXP-006): continuidad de la cotizacion si Open Data llega a caer

# false = linea base sin tacticas (timeout 5 s y 503), con la misma imagen.
RESILIENCIA_HABILITADA=true
# Timeout de la llamada a Terceros (ms).
TERCEROS_TIMEOUT_MS=300
# Circuit breaker: se abre si falla el 50 % de al menos 5 llamadas en 10 s y
# no vuelve a llamar a Terceros durante 30 s (luego half-open).
CB_UMBRAL_ERROR_PCT=50
CB_VOLUMEN_MINIMO=5
CB_VENTANA_MS=10000
CB_ESPERA_ABIERTO_MS=30000
# Bulkhead: pool de conexiones propio hacia Terceros y tope de llamadas simultaneas.
BULKHEAD_CONEXIONES=20
BULKHEAD_CONCURRENCIA=20
# Redis propio de Cotizacion: ultimo score de Open Data por cliente.
REDIS_URL=redis://localhost:6380
REDIS_TIMEOUT_MS=50
SCORE_CACHE_TTL_S=604800
# Score si Terceros falla y el cliente no tiene score en cache (0 = sin descuento).
SCORE_POR_DEFECTO=0
# Cada cuantos segundos cada replica escribe su linea de metricas en el log.
METRICAS_INTERVALO_S=10